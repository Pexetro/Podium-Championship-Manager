<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creme"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- CABEÇALHO: FASE -->
        <TextView
            android:id="@+id/tvFaseJogoDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fase de Grupos"
            android:textColor="@color/gold_detail"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- PLACAR VISUAL -->
        <LinearLayout
            android:id="@+id/layoutPlacar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvFaseJogoDetalhe">

            <TextView
                android:id="@+id/tvTimeMandanteDetalhe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Time A"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="end" />

            <TextView
                android:id="@+id/tvPlacarDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="0 - 0"
                android:textColor="@color/primary_green"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimeVisitanteDetalhe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Time B"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="start" />
        </LinearLayout>

        <!-- DETALHES EXTRAS DA PONTUAÇÃO (Sets e Tempo) -->
        <TextView
            android:id="@+id/tvSetsDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="(3 - 1 SET)"
            android:textColor="@color/gold_detail"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPlacar" />

        <TextView
            android:id="@+id/tvTempoDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2º TEMPO"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSetsDetalhe" />

        <!-- DATA E HORA -->
        <TextView
            android:id="@+id/tvDataHoraDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="12/11/2026 às 16:00"
            android:textColor="@color/text_dark"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTempoDetalhe" />

        <!-- CARD DE EDIÇÃO (Só aparece para administradores) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEdicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvDataHoraDetalhe">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lançar Placar"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <!-- Gols -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etGolsMandanteDetalhe"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Gols Mandante"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etGolsVisitanteDetalhe"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Gols Visitante"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbFinalizarDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Marcar como Finalizado" />

                <!-- Sets -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Detalhes de Sets (Vôlei/Tênis)"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/etSetsMandante"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Sets Mandante"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etSetsVisitante"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Sets Visitante"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Tempo Atual -->
                <TextView
                    android:id="@+id/tvTituloTempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tempo Atual (Ex: 1º Tempo, 2º Set)"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/etTempoAtual"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Ex: 2º Tempo"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÃO SALVAR -->
        <Button
            android:id="@+id/btSalvarPlacar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            android:backgroundTint="@color/primary_green"
            android:text="SALVAR PLACAR"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardEdicao" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>