<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creme"
    tools:context=".EntrarTimeActivity">

    <!-- CABEÇALHO -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="Entrar em um Time"
        android:textColor="@color/primary_green"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:text="Encontre um time e faça parte dele!"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"/>

    <!-- DIVISÓRIA -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:background="#D4AF37"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"/>

    <!-- INSTRUÇÃO -->
    <TextView
        android:id="@+id/tvInstrucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:text="Digite o nome do time que deseja encontrar:"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/divider"/>

    <!-- CAMPO DE PESQUISA -->
    <EditText
        android:id="@+id/etNomeTime"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Nome do time"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_dark"
        android:textColorHint="#999999"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btPesquisar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstrucao"/>

    <!-- BOTÃO PESQUISAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btPesquisar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Pesquisar time"
        app:backgroundTint="@color/primary_green"
        app:cornerRadius="10dp"
        app:icon="@android:drawable/ic_menu_search"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/etNomeTime"/>

    <!-- TÍTULO DOS RESULTADOS -->
    <TextView
        android:id="@+id/tvResultados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:text="Times encontrados"
        android:textColor="@color/primary_green"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etNomeTime"/>

    <!-- CARD DO TIME ENCONTRADO -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="#D4AF37"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvResultados">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <!-- ÍCONE -->
            <ImageView
                android:id="@+id/ivTime"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_green"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@android:color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- NOME DO TIME -->
            <TextView
                android:id="@+id/tvNomeTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Nome do Time"
                android:textColor="@color/primary_green"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivTime"
                app:layout_constraintTop_toTopOf="@id/ivTime"/>

            <!-- MODALIDADE -->
            <TextView
                android:id="@+id/tvModalidadeTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="5dp"
                android:text="Modalidade: Futebol"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivTime"
                app:layout_constraintTop_toBottomOf="@id/tvNomeTime"/>

            <!-- BOTÃO SOLICITAR ENTRADA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btSolicitarEntrada"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Solicitar entrada"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_green"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@id/ivTime"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- MENSAGEM INICIAL -->
    <TextView
        android:id="@+id/tvMensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Pesquise pelo nome de um time para visualizar os resultados."
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/cardTime"/>

</androidx.constraintlayout.widget.ConstraintLayout>
