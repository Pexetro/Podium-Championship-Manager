<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creme"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Ícone do Usuário -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_green"
            android:padding="20dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <!-- Campo Nome -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNomePerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNomePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome completo"
                android:enabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmailPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilNomePerfil">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmailPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:enabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Nova Senha (Opcional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSenhaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:passwordToggleEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/tilEmailPerfil">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSenhaPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nova Senha (deixe em branco para não alterar)"
                android:inputType="textPassword"
                android:enabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botão Editar -->
        <Button
            android:id="@+id/btEditar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary_green"
            android:text="EDITAR PERFIL"
            app:layout_constraintTop_toBottomOf="@id/tilSenhaPerfil" />

        <!-- Botão Sair -->
        <Button
            android:id="@+id/btSair"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#D32F2F"
            android:text="SAIR DA CONTA"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btEditar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>