<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Placar do Jogo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Gols Mandante -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gols do Mandante:" />
    <EditText
        android:id="@+id/etGolsMandante"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_edit_text"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp"/>

    <!-- Gols Visitante -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Gols do Visitante:" />
    <EditText
        android:id="@+id/etGolsVisitante"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/bg_edit_text"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp"/>

    <!-- Status (Opcional) -->
    <CheckBox
        android:id="@+id/cbFinalizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Marcar como Finalizado" />

</LinearLayout>